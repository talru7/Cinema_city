# Runtime profile
APP_ENV=local
API_MODE=combined
HOST=127.0.0.1
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=

# Authentication
AUTH_ENABLED=false
AUTH_PROVIDER=none
MANAGER_EMAILS=
NOAUTH_CUSTOMER_EMAIL=customer@local.invalid
NOAUTH_MANAGER_EMAIL=manager@local.invalid

# Clerk - backend secrets never belong in HTML or JavaScript
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_FRONTEND_API_URL=
CLERK_BACKEND_API_URL=https://api.clerk.com
CLERK_AUTHORIZED_PARTIES=

# Storage
STORAGE_BACKEND=json
CINEMA_DATA_DIR=
CINEMA_LOG_DIR=

# Neon/PostgreSQL - implemented production adapter
NEON_DATABASE_URL=
AUTO_CREATE_SCHEMA=false

# Reserved adapter settings for future D1 and MongoDB implementations
D1_DATABASE_ID=
D1_ACCOUNT_ID=
D1_API_TOKEN=

MONGODB_URI=
MONGODB_DATABASE=cinema_city
